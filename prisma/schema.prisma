generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model admission {
  id               String                      @id
  patientId        String
  type             admission_type
  status           admission_status            @default(active)
  admittedAt       DateTime                    @default(now())
  dischargedAt     DateTime?
  wardId           String?
  patientCondition admission_patientCondition?
  opdSessionId     String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime
  bedId            String?
  bed              bed?                        @relation(fields: [bedId], references: [id], map: "Admission_bedId_fkey")
  opdsession       opdsession?                 @relation(fields: [opdSessionId], references: [id], map: "Admission_opdSessionId_fkey")
  patient          patient                     @relation(fields: [patientId], references: [id], map: "Admission_patientId_fkey")
  ward             ward?                       @relation(fields: [wardId], references: [id], map: "Admission_wardId_fkey")
  otcase           otcase?
  patientdoctor    patientdoctor[]
  transferrequest  transferrequest[]

  @@index([bedId], map: "Admission_bedId_fkey")
  @@index([opdSessionId], map: "Admission_opdSessionId_fkey")
  @@index([patientId], map: "Admission_patientId_fkey")
  @@index([wardId], map: "Admission_wardId_fkey")
}

model announcement {
  id        String             @id
  text      String             @db.Text
  board     announcement_board @default(ALL)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime
}

model auditlog {
  id        String   @id
  userId    String
  action    String
  target    String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "AuditLog_userId_fkey")

  @@index([userId], map: "AuditLog_userId_fkey")
}

model bed {
  id        String      @id
  bedNo     String
  wardId    String
  createdAt DateTime    @default(now())
  updatedAt DateTime
  admission admission[]
  ward      ward        @relation(fields: [wardId], references: [id], onDelete: Cascade, map: "Bed_wardId_fkey")

  @@unique([wardId, bedNo], map: "Bed_wardId_bedNo_key")
}

model department {
  id        String   @id
  name      String
  floor     String
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())
  updatedAt DateTime
  doctor    doctor[]
}

model doctor {
  id              String            @id
  userId          String            @unique(map: "Doctor_userId_key")
  designation     String
  roomNo          String?
  speciality      String?
  departmentId    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  department      department?       @relation(fields: [departmentId], references: [id], map: "Doctor_departmentId_fkey")
  user            user              @relation(fields: [userId], references: [id], map: "Doctor_userId_fkey")
  opdsession      opdsession[]
  otassistant     otassistant[]
  otcase          otcase[]
  patientdoctor   patientdoctor[]
  transferrequest transferrequest[]

  @@index([departmentId], map: "Doctor_departmentId_fkey")
}

model hospitalsettings {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model opdsession {
  id             String            @id
  doctorId       String
  date           DateTime          @db.Date
  startTime      String
  endTime        String
  status         opdsession_status @default(upcoming)
  currentToken   Int?
  totalTokens    Int               @default(0)
  avgWaitMinutes Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  opdNo          String?
  floor          String?
  admission      admission[]
  doctor         doctor            @relation(fields: [doctorId], references: [id], map: "OpdSession_doctorId_fkey")

  @@index([doctorId], map: "OpdSession_doctorId_fkey")
}

model otassistant {
  id       String @id
  otCaseId String
  doctorId String
  doctor   doctor @relation(fields: [doctorId], references: [id], map: "OtAssistant_doctorId_fkey")
  otcase   otcase @relation(fields: [otCaseId], references: [id], map: "OtAssistant_otCaseId_fkey")

  @@unique([otCaseId, doctorId], map: "OtAssistant_otCaseId_doctorId_key")
  @@index([doctorId], map: "OtAssistant_doctorId_fkey")
}

model otcase {
  id                String        @id
  admissionId       String        @unique(map: "OtCase_admissionId_key")
  otRoomId          String?
  leadDoctorId      String?
  procedureName     String
  anaesthetist      String?
  scheduledTime     String?
  estimatedDuration Int?
  status            otcase_status @default(scheduled)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  otassistant       otassistant[]
  admission         admission     @relation(fields: [admissionId], references: [id], map: "OtCase_admissionId_fkey")
  doctor            doctor?       @relation(fields: [leadDoctorId], references: [id], map: "OtCase_leadDoctorId_fkey")
  otroom            otroom?       @relation(fields: [otRoomId], references: [id], map: "OtCase_otRoomId_fkey")

  @@index([leadDoctorId], map: "OtCase_leadDoctorId_fkey")
  @@index([otRoomId], map: "OtCase_otRoomId_fkey")
}

model otroom {
  id        String   @id
  roomNo    String   @unique(map: "OtRoom_roomNo_key")
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime
  otcase    otcase[]
}

model patient {
  id                    String          @id
  name                  String
  age                   Int?
  gender                patient_gender?
  contact               String?
  address               String?
  bloodGroup            String?
  chiefComplaint        String?         @db.Text
  diagnosis             String?         @db.Text
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceProvider     String?
  policyNumber          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  admission             admission[]
}

model patientdoctor {
  id          String             @id
  admissionId String
  doctorId    String
  role        patientdoctor_role @default(primary)
  admission   admission          @relation(fields: [admissionId], references: [id], map: "PatientDoctor_admissionId_fkey")
  doctor      doctor             @relation(fields: [doctorId], references: [id], map: "PatientDoctor_doctorId_fkey")

  @@unique([admissionId, doctorId], map: "PatientDoctor_admissionId_doctorId_key")
  @@index([doctorId], map: "PatientDoctor_doctorId_fkey")
}

model transferrequest {
  id              String                     @id
  admissionId     String
  requestingDocId String
  targetType      transferrequest_targetType
  notes           String?                    @db.Text
  status          String                     @default("pending")
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime
  admission       admission                  @relation(fields: [admissionId], references: [id], map: "TransferRequest_admissionId_fkey")
  doctor          doctor                     @relation(fields: [requestingDocId], references: [id], map: "TransferRequest_requestingDocId_fkey")

  @@index([admissionId], map: "TransferRequest_admissionId_fkey")
  @@index([requestingDocId], map: "TransferRequest_requestingDocId_fkey")
}

model user {
  id        String     @id @default(cuid())
  email     String     @unique(map: "User_email_key")
  password  String
  name      String
  role      user_role
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditlog  auditlog[]
  doctor    doctor?
}

model ward {
  id          String      @id
  name        String
  code        String
  capacity    Int         @default(20)
  accentColor String      @default("#3b82f6")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  floorNo     String?
  roomNo      String?
  admission   admission[]
  bed         bed[]
}

enum admission_type {
  OPD
  IPD
  OT
}

enum announcement_board {
  OPD
  IPD
  OT
  ALL
}

enum admission_status {
  active
  discharged
  transferred
}

enum patient_gender {
  M
  F
  Other
}

enum patientdoctor_role {
  primary
  consultant
}

enum transferrequest_targetType {
  OPD
  IPD
  OT
}

enum user_role {
  ADMIN
  DOCTOR
  RECEPTIONIST
  NURSE
}

enum opdsession_status {
  upcoming
  running
  break
  completed
  unavailable
}

enum admission_patientCondition {
  stable
  monitoring
  critical
}

enum otcase_status {
  scheduled
  preparing
  in_progress
  completed
  delayed
  cancelled
}
